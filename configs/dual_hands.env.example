# 双手 VLA 默认运行参数示例。
# 使用方式：
#   source /opt/ros/humble/setup.bash
#   python3 scripts/dual_hands_collect.py $DUAL_HANDS_ARGS

DUAL_HANDS_ARGS="\
  --output-dir /home/ubuntu/cbc_tienkung2.0_vla_collect_data/vla_recorded_data/dual_hands \
  --target-hz 20 \
  --max-camera-dt 0.08 \
  --max-state-dt 0.05 \
  --image-write-mode original \
  --required-state-streams arm_cmd,arm_status,left_hand_state,right_hand_state \
  --head-topic /camera/color/image_raw/compressed \
  --head-image-type compressed_image \
  --left-hand-image-topic /camera/d405_left/color/image_h264 \
  --left-hand-image-type compressed_video \
  --right-hand-image-topic /camera/d405_right/color/image_h264 \
  --right-hand-image-type compressed_video \
  --arm-cmd-topic /arm/cmd_ctrl \
  --arm-status-topic /arm/status \
  --left-hand-state-topic /inspire_hand/state/left_hand \
  --right-hand-state-topic /inspire_hand/state/right_hand"
